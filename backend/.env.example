# All integrations are optional. The local demo needs no environment variables.

# Frontend origin for CORS
CUTLINE_FRONTEND_ORIGIN=http://localhost:5173

# Optional: Langfuse v4 telemetry
CUTLINE_LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional: Overmind
CUTLINE_OVERMIND_ENABLED=0
OVERMIND_API_KEY=
OVERMIND_AGENT_ID=
OVERMIND_PROJECT_ID=

# Optional: Supabase server-side mirroring
CUTLINE_SUPABASE_ENABLED=0
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: Modal authentication is normally configured with `modal setup`
CUTLINE_MODAL_ENABLED=0
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
